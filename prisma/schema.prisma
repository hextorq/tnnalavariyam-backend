// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                     @id @default(autoincrement())
  name         String?
  firstName    String?
  lastName     String?
  username     String                  @unique
  email        String                  @unique
  phone        String?                 @unique
  passwordHash String
  role         UserRole                @default(CITIZEN)
  scopeId      Int?
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  scope        GeoUnit?                @relation(fields: [scopeId], references: [id])
  applications ApplicationSubmission[]
  auditLogs    AuditLog[]

  @@index([role])
  @@index([scopeId])
}

model GeoUnit {
  id            Int                     @id @default(autoincrement())
  name          String
  tamilName     String?
  type          GeoUnitType
  code          String?                 @unique
  parentId      Int?
  path          String                  @default("/")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  parent        GeoUnit?                @relation("GeoHierarchy", fields: [parentId], references: [id])
  children      GeoUnit[]               @relation("GeoHierarchy")
  users         User[]
  applications  ApplicationSubmission[]

  @@index([type])
  @@index([parentId])
  @@index([path])
}

model ApplicationForm {
  id           Int                     @id @default(autoincrement())
  key          String                  @unique
  title        String
  tamilTitle   String
  description  String?                 @db.Text
  feeAmount    Decimal?                @db.Decimal(10, 2)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  submissions  ApplicationSubmission[]
}

model ApplicationSubmission {
  id              Int                  @id @default(autoincrement())
  applicationNo   String               @unique
  userId          Int
  formId          Int
  geoUnitId       Int?
  status          ApplicationStatus    @default(DRAFT)
  paymentStatus   PaymentStatus        @default(PENDING)
  paymentAmount   Decimal?             @db.Decimal(10, 2)
  paymentReference String?
  paymentPaidAt   DateTime?
  applicantData   Json
  paymentData     Json?
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id])
  form            ApplicationForm      @relation(fields: [formId], references: [id])
  geoUnit         GeoUnit?             @relation(fields: [geoUnitId], references: [id])
  documents       UploadedDocument[]

  @@index([userId])
  @@index([formId])
  @@index([geoUnitId])
  @@index([status])
}

model UploadedDocument {
  id            Int                   @id @default(autoincrement())
  submissionId  Int
  fieldKey      String
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  path          String
  createdAt     DateTime              @default(now())
  submission    ApplicationSubmission @relation(fields: [submissionId], references: [id])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  STATE_ADMIN
  DISTRICT_ADMIN
  TALUK_ADMIN
  VILLAGE_ADMIN
  CITIZEN
}

enum GeoUnitType {
  STATE
  DISTRICT
  TALUK
  VILLAGE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
