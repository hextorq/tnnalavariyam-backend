// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                     @id @default(autoincrement())
  name         String?
  firstName    String?
  lastName     String?
  username     String                  @unique
  email        String                  @unique
  phone        String?                 @unique
  passwordHash String
  role         UserRole                @default(PARTNER)
  scopeId      Int?
  photoPath    String?
  isActive     Boolean                 @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  scope        GeoUnit?                @relation(fields: [scopeId], references: [id])
  applications ApplicationSubmission[]
  reviewedSubmissions ApplicationSubmission[] @relation("LastSubmissionReviewer")
  reviewActions ApplicationReview[]
  reviewedSignupRequests UserSignupRequest[] @relation("SignupReviewer")
  auditLogs    AuditLog[]

  @@index([role])
  @@index([scopeId])
}

model UserSignupRequest {
  id              Int                  @id @default(autoincrement())
  requestNo       String               @unique
  requestedRole   UserRole
  scopeId         Int
  status          SignupRequestStatus  @default(PENDING)
  username        String
  fullName        String
  email           String
  phone           String
  passwordHash    String
  addressLine     String               @db.Text
  state           String               @default("Tamil Nadu")
  district        String
  taluk           String
  village         String
  pincode         String
  photoPath       String?
  idProofType     IdProofType
  idProofNumber   String?
  idProofPath     String?
  reviewReason    String?              @db.Text
  reviewedById    Int?
  reviewedAt      DateTime?
  approvedUserId  Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  scope           GeoUnit              @relation(fields: [scopeId], references: [id])
  reviewedBy      User?                @relation("SignupReviewer", fields: [reviewedById], references: [id])

  @@index([requestedRole])
  @@index([scopeId])
  @@index([status])
  @@index([reviewedById])
}

model GeoUnit {
  id            Int                     @id @default(autoincrement())
  name          String
  tamilName     String?
  type          GeoUnitType
  code          String?                 @unique
  parentId      Int?
  path          String                  @default("/")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  parent        GeoUnit?                @relation("GeoHierarchy", fields: [parentId], references: [id])
  children      GeoUnit[]               @relation("GeoHierarchy")
  users         User[]
  applications  ApplicationSubmission[]
  signupRequests UserSignupRequest[]

  @@index([type])
  @@index([parentId])
  @@index([path])
}

model ApplicationForm {
  id           Int                     @id @default(autoincrement())
  key          String                  @unique
  title        String
  tamilTitle   String
  description  String?                 @db.Text
  feeAmount    Decimal?                @db.Decimal(10, 2)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  submissions  ApplicationSubmission[]
}

model ApplicationSubmission {
  id              Int                  @id @default(autoincrement())
  applicationNo   String               @unique
  userId          Int
  formId          Int
  geoUnitId       Int?
  status          ApplicationStatus    @default(DRAFT)
  paymentStatus   PaymentStatus        @default(PENDING)
  paymentAmount   Decimal?             @db.Decimal(10, 2)
  paymentReference String?
  paymentPaidAt   DateTime?
  currentReviewReason String?         @db.Text
  currentReviewLevel  Int              @default(1)
  lastReviewedById Int?
  lastReviewedAt  DateTime?
  revisionCount   Int                  @default(0)
  applicantData   Json
  paymentData     Json?
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id])
  form            ApplicationForm      @relation(fields: [formId], references: [id])
  geoUnit         GeoUnit?             @relation(fields: [geoUnitId], references: [id])
  lastReviewedBy  User?                @relation("LastSubmissionReviewer", fields: [lastReviewedById], references: [id])
  documents       UploadedDocument[]
  reviewHistory   ApplicationReview[]

  @@index([userId])
  @@index([formId])
  @@index([geoUnitId])
  @@index([status])
  @@index([lastReviewedById])
}

model ApplicationReview {
  id            Int                   @id @default(autoincrement())
  submissionId  Int
  actorId       Int?
  action        ReviewAction
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?               @db.Text
  createdAt     DateTime              @default(now())
  submission    ApplicationSubmission @relation(fields: [submissionId], references: [id])
  actor         User?                 @relation(fields: [actorId], references: [id])

  @@index([submissionId])
  @@index([actorId])
  @@index([action])
}

model UploadedDocument {
  id            Int                   @id @default(autoincrement())
  submissionId  Int
  fieldKey      String
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  path          String
  createdAt     DateTime              @default(now())
  submission    ApplicationSubmission @relation(fields: [submissionId], references: [id])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  STATE_ADMIN
  DISTRICT_ADMIN
  TALUK_ADMIN
  VILLAGE_ADMIN
  PARTNER
  CITIZEN
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdProofType {
  VOTER_ID
  RATION_CARD
  AADHAR_CARD
  PAN_CARD
  DRIVING_LICENSE
}

enum GeoUnitType {
  STATE
  DISTRICT
  TALUK
  VILLAGE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CORRECTION
  RESUBMITTED
  FORWARDED_TO_TALUK
  FORWARDED_TO_DISTRICT
  FORWARDED_TO_STATE
  APPROVED
  REJECTED
}

enum ReviewAction {
  SUBMITTED
  UPDATED
  REVIEW_STARTED
  CORRECTION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  FORWARDED_TO_TALUK
  FORWARDED_TO_DISTRICT
  FORWARDED_TO_STATE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
